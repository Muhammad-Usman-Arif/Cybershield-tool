# ==========================================
# CyberShield AI - Environment Configuration
# ==========================================

# Core Application Security
SECRET_KEY=cybershield-ai-production-super-secret-key-32-chars-min!

# Database Configuration (SQLite default; PostgreSQL supported e.g. postgresql://user:pass@localhost:5432/cybershield)
DATABASE_URL=sqlite:///cybershield.db

# Flask Environment: development | production | testing
FLASK_ENV=development

# File Upload Storage Directory
UPLOAD_FOLDER=uploads

# Maximum Upload File Size in Bytes (default: 16 MB = 16 * 1024 * 1024)
MAX_CONTENT_LENGTH=16777216

# Default Initial Administrator / SOC Lead Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cybershield.local
ADMIN_PASSWORD=CyberShield2026!
